/**
 * このファイルは `infra/user-config.ts` にコピーして使う (コピー先は .gitignore 済み)。
 *
 * ## CI / 他環境から deploy するとき (ADR 0028 D-6)
 *
 * `user-config.ts` はコミットされないので **CI には存在しない**。環境変数で上書きできる:
 *
 * | 環境変数                             | 対応する項目            |
 * | ------------------------------------ | ----------------------- |
 * | `STAGECAST_MEDIA_HOSTED_ZONE_NAME`   | `mediaHostedZoneName`   |
 * | `STAGECAST_ACME_EMAIL`               | `acmeEmail`             |
 *
 * GitHub Actions では repository variables から渡している
 * (`.github/workflows/deploy.yml` の `env:`)。新しい環境を足すときは
 * `gh variable set STAGECAST_MEDIA_HOSTED_ZONE_NAME --body "<ゾーン名>"` のように設定する。
 *
 * **渡し忘れると `mediaHostedZoneName` が未設定の構成でデプロイされる。** CloudFront の
 * 独自ドメインと Route53 レコードが消え、Cognito のコールバックが払い出しドメインに戻るため、
 * **管理画面にログインできなくなる**。
 */
import type { UserConfig } from "./lib/user-config";

const config: UserConfig = {
  // Route53 ホストゾーン名。LiveKit シグナリング TLS 用。
  // 設定すると *.media.<ドメイン> で Caddy ACME 自動 HTTPS が有効になる。
  // mediaHostedZoneName: "aws.example.com",

  // Cognito に初期管理者を自動作成（カンマ区切り）。
  // initialAdmins: "admin@example.com",

  // AWS Budgets 月額上限 (USD)。デフォルト: 50。
  // budgetMonthlyUsd: 50,

  // コストアラート通知先メールアドレス。
  // budgetEmail: "ops@example.com",

  // 運用アラームの通知先メールアドレス (スタックが立たない等)。
  // **未設定だとアラームは誰にも届かない** (SNS に publish されて消えるだけ)。
  // opsEmail: "ops@example.com",

  // Caddy が Let's Encrypt に登録する ACME アカウントの連絡先 (mediaHostedZoneName 使用時)。
  // **未設定だと証明書の更新に失敗し続け、期限切れで全イベントの wss:// が繋がらなくなる。**
  // 未設定なら opsEmail にフォールバックするので、どちらか一方は必ず書くこと。
  // 表示名付き ("Ops Team <ops@example.com>") は不可。素のアドレスだけを書く。
  // acmeEmail: "ops@example.com",
};

export default config;
